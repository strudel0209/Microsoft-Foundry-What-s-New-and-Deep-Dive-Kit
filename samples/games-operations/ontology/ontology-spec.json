  "metrics": [
    {
      "name": "Gold Medals",
      "semantic_model": "Games Operations Model",
      "home_table": "result",
      "dax": "CALCULATE ( COUNTROWS ( 'result' ), 'result'[medal] = \"Gold\" )",
      "used_by": "NOC"
    },
    {
      "name": "Silver Medals",
      "semantic_model": "Games Operations Model",
      "home_table": "result",
      "dax": "CALCULATE ( COUNTROWS ( 'result' ), 'result'[medal] = \"Silver\" )",
      "used_by": "NOC"
    },
    {
      "name": "Bronze Medals",
      "semantic_model": "Games Operations Model",
      "home_table": "result",
      "dax": "CALCULATE ( COUNTROWS ( 'result' ), 'result'[medal] = \"Bronze\" )",
      "used_by": "NOC"
    },
    {
      "name": "Total Medals",
      "semantic_model": "Games Operations Model",
      "home_table": "result",
      "dax": "[Gold Medals] + [Silver Medals] + [Bronze Medals]",
      "used_by": "NOC"
    },
    {
      "name": "Tickets Sold",
      "semantic_model": "Games Operations Model",
      "home_table": "session_ticketing",
      "dax": "SUM ( 'session_ticketing'[tickets_sold] )",
      "used_by": "Session, Venue"
    },
    {
      "name": "Seats Available",
      "semantic_model": "Games Operations Model",
      "home_table": "session_ticketing",
      "dax": "SUM ( 'session_ticketing'[seats_available] )",
      "used_by": "Session, Venue"
    },
    {
      "name": "Sell-Through Rate",
      "semantic_model": "Games Operations Model",
      "home_table": "session_ticketing",
      "dax": "DIVIDE ( [Tickets Sold], [Seats Available] )",
      "used_by": "Session, Venue"
    },
    {
      "name": "Attendance Rate",
      "semantic_model": "Games Operations Model",
      "home_table": "session_ticketing",
      "dax": "DIVIDE ( SUM ( 'session_ticketing'[scanned_entries] ), CALCULATE ( [Tickets Sold], NOT ISBLANK ( 'session_ticketing'[scanned_entries] ) ) )",
      "used_by": "Session, Venue"
    },
    {
      "name": "Completed Sessions",
      "semantic_model": "Games Operations Model",
      "home_table": "session",
      "dax": "CALCULATE ( COUNTROWS ( 'session' ), 'session'[session_status] = \"Completed\" )",
